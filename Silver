## Create sensor humidity table
# now we are going to generate synthetic sensor data for humidity at the item level
# we are only adding new readings
import random

sensor_table = "wine_sales_catalog.silver.sensor_humidity"

if not spark.catalog.tableExists(sensor_table):
    sales_df = spark.sql("SELECT sales_id, item_code, date_id FROM wine_sales_catalog.silver.sales_table")
    sales_data = sales_df.collect()
    synthetic_data = []
    for idx, row in enumerate(sales_data):
        # 90% normal humidity (55-65), 10% too humid (70-80)
        if random.random() < 0.9:
            value = round(random.uniform(55, 65), 1)
        else:
            value = round(random.uniform(70, 80), 1)
        synthetic_data.append((idx, row.sales_id, row.item_code, row.date_id, "humidity", value))
    df = spark.createDataFrame(synthetic_data, ["id", "sales_id", "item_code", "date_id", "sensor_description", "sensor_value"])
    df.write.format("delta").saveAsTable(sensor_table)
# display some rows from sensor table
display(spark.sql(f"select * from {sensor_table} limit 5"))
