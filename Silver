## Create Sales Table
# create sales table or merge new sales data
if not spark.catalog.tableExists("wine_sales_catalog.silver.sales_table"):
    spark.sql(f"""
    CREATE TABLE wine_sales_catalog.silver.sales_table
    CLUSTER BY (item_code, date_id)
    AS
    SELECT
      monotonically_increasing_id() AS sales_id,
      r.RETAIL_SALES,
      r.WAREHOUSE_SALES,
      d.date_id,
      i.ITEM_CODE
    FROM
      {source_table} r
    INNER JOIN
      wine_sales_catalog.silver.date_table d
    ON
      r.YEAR = d.YEAR AND r.MONTH = d.MONTH
    INNER JOIN
      wine_sales_catalog.silver.item_table i
    ON
      r.ITEM_CODE = i.ITEM_CODE AND d.date_id = i.date_id
    WHERE
      r.WAREHOUSE_SALES is not null AND r.RETAIL_SALES is not null
  """)
else:
    spark.sql(f"""
    MERGE INTO wine_sales_catalog.silver.sales_table AS target
    USING (
      SELECT
        monotonically_increasing_id() AS sales_id,
        r.RETAIL_SALES,
        r.WAREHOUSE_SALES,
        d.date_id,
        i.ITEM_CODE
      FROM
        {source_table} r
      INNER JOIN
        wine_sales_catalog.silver.date_table d
      ON
        r.YEAR = d.YEAR AND r.MONTH = d.MONTH
      INNER JOIN
        wine_sales_catalog.silver.item_table i
      ON
        r.ITEM_CODE = i.ITEM_CODE AND d.date_id = i.date_id
      WHERE
        r.WAREHOUSE_SALES is not null AND r.RETAIL_SALES is not null
    ) AS source
    ON target.item_code = source.ITEM_CODE
    WHEN NOT MATCHED THEN
      INSERT (sales_id, retail_sales, warehouse_sales, date_id, item_code)
      VALUES (source.sales_id, source.RETAIL_SALES, source.WAREHOUSE_SALES, source.date_id, source.ITEM_CODE)
    """)
