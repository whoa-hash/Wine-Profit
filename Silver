source_table = "wine_sales_catalog.bronze.raw_csv_data"

%sql
-- create date table for year and month from bronze table
create or replace table wine_sales_catalog.silver.date_table
CLUSTER BY (YEAR, MONTH)
AS
SELECT 
  monotonically_increasing_id() AS date_id,
  YEAR,
  MONTH
FROM wine_sales_catalog.bronze.raw_csv_data
WHERE YEAR IS NOT NULL AND MONTH IS NOT NULL AND YEAR > 1900 AND MONTH BETWEEN 1 AND 12
GROUP BY YEAR, MONTH
ORDER BY YEAR, MONTH
# check to make sure date loaded
display(spark.sql("select * from wine_sales_catalog.silver.date_table order by year, month"))
# if table exists already, count how many records it already has
if spark.catalog.tableExists("wine_sales_catalog.silver.item_table"):
    df = spark.sql("select count(1) from wine_sales_catalog.silver.item_table")
    print(f"Table already exists with {df.first()[0]} records")
   
# create or merge item table from raw with date id
# if table does not exist, create it
if not spark.catalog.tableExists("wine_sales_catalog.silver.item_table"):
    spark.sql(f"""
    CREATE TABLE wine_sales_catalog.silver.item_table
    CLUSTER BY (ITEM_CODE)
    AS
    SELECT
      r.ITEM_CODE,
      r.ITEM_DESCRIPTION,
      r.ITEM_TYPE,
      r.Supplier,
      d.date_id
    FROM
      {source_table} r
    INNER JOIN
      wine_sales_catalog.silver.date_table d
    ON
      r.YEAR = d.YEAR AND r.MONTH = d.MONTH
    WHERE
      r.ITEM_CODE IS NOT NULL 
    """)

spark.sql(f"""
MERGE INTO wine_sales_catalog.silver.item_table AS target
USING (
  SELECT
    r.ITEM_CODE,
    r.ITEM_DESCRIPTION,
    r.ITEM_TYPE,
    r.Supplier,
    d.date_id
  FROM
    {source_table} r
  INNER JOIN
    wine_sales_catalog.silver.date_table d
  ON
    r.YEAR = d.YEAR AND r.MONTH = d.MONTH
  WHERE
    r.ITEM_CODE IS NOT NULL 
) AS source
ON target.ITEM_CODE = source.ITEM_CODE
WHEN NOT MATCHED THEN
  INSERT (ITEM_CODE, ITEM_DESCRIPTION, ITEM_TYPE, Supplier, date_id)
  VALUES (source.ITEM_CODE, source.ITEM_DESCRIPTION, source.ITEM_TYPE, source.Supplier, source.date_id)
""")
# check to see if data was loaded to item table
display(spark.sql("select count(1) from wine_sales_catalog.silver.item_table"))
# read in item table as df and check schema
